# ──────────────────────────────────────────────────────────────
# Contact form — OPTIONAL server-side email delivery
# ──────────────────────────────────────────────────────────────
# The contact form works out of the box with NO configuration:
# it opens the visitor's email client via a prefilled mailto link.
#
# If you also want server-side delivery (so submissions hit the
# /api/contact endpoint and get emailed to you), add a Resend key.
# Get one free at https://resend.com — then `npm install resend`.
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=ahmadrezakhanari02@gmail.com
# CONTACT_FROM_EMAIL=portfolio@yourdomain.com

# Canonical site URL — used for SEO metadata, sitemap, and OG tags.
NEXT_PUBLIC_SITE_URL=https://ahmadrkh.github.io
